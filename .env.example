# Example .env for local development
# NOTE: VITE_APP_ID and JWT_SECRET are required for auth to work locally.
# VITE_APP_ID can be any non-empty string for local dev (must match OAuth server when using OAuth).
VITE_APP_ID="smartmeal-local"
DATABASE_URL="mysql://smuser:smsecret@127.0.0.1:3306/smartmeal_dev"
JWT_SECRET="dev-jwt-secret-change-me"
VITE_GOOGLE_CLIENT_ID=""
VITE_OAUTH_SERVER_URL="http://localhost:4000"
OWNER_OPEN_ID=""
